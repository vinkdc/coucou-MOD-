{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "What Kotoba’s windows are allowed to do. Everything that touches the OS goes through Kotoba’s own commands.",
  "windows": [
    "island",
    "settings",
    "skin-editor",
    "askpop"
  ],
  "permissions": [
    "core:default",
    "core:window:allow-start-dragging",
    "core:window:allow-hide",
    "autostart:default"
  ]
}
